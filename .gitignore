# Third-party material, restored per external/README.md (not ours to redistribute;
# the OSF deposit alone is 3.1 GB)
external/*
!external/README.md

# Published papers: copyrighted PDFs (112 MB) and text extracted from them.
# The index (papers/README.md) is tracked; the papers are re-downloaded per its links.
papers/*
!papers/README.md
notes/paper_text/

# Generated outputs (rebuild with the scripts next to them)
docs/handbook/word/
docs/handbook/pdf/
presentation/*.pptx
presentation/_chalmers-template.pptx

# Python
__pycache__/
*.pyc

# In-progress simulation checkpoints
*.partial

# full-population (5000-seed) condition CSVs: 60-250 MB each, over GitHub limits;
# regenerable from the commands in replication/causation/out/log_fullp*.txt
replication/causation/out/cond_*_fullp*.csv
